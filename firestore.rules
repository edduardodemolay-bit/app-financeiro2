rules_version = '2';
// Regras de acesso da nuvem (Firestore) do EddFinança.
//
//  usuarios/{id}  -> espaço individual de cada conta (lançamentos, metas, planejamento, histórico).
//                    Só a própria pessoa lê, grava e apaga. Nem o administrador vê.
//  acessos/{id}   -> cadastro e acessos de cada conta (nome completo, e-mail, idade, datas).
//                    A pessoa cria e apaga o seu; o administrador vê todos e pode bloquear/liberar.
//  admins/{id}    -> quem é administrador. Só se cria pelo console do Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function dono(uid) { return logado() && request.auth.uid == uid; }
    function ehAdmin() { return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function bloqueado(uid) {
      return exists(/databases/$(database)/documents/acessos/$(uid))
        && get(/databases/$(database)/documents/acessos/$(uid)).data.get('bloqueado', false) == true;
    }

    // Espaço individual: só o dono, e só se o acesso não estiver bloqueado.
    // Apagar é permitido ao dono (botão "Excluir minha conta e meus dados", LGPD).
    match /usuarios/{uid} {
      allow read: if dono(uid) && !bloqueado(uid);
      allow create, update: if dono(uid) && !bloqueado(uid);
      allow delete: if dono(uid);

      // Caixa de entrada do WhatsApp: o servidor (que ignora estas regras) deixa aqui os
      // lançamentos que chegaram por mensagem; o app da própria pessoa lê e apaga ao lançar.
      match /whatsapp/{item} {
        allow read, delete: if dono(uid) && !bloqueado(uid);
        allow create, update: if false;
      }
    }

    // ===== WHATSAPP =====
    // vinculosWhatsapp/{codigo}: código temporário "LIGAR 123456" criado pelo app da pessoa.
    // Só quem criou apaga; ninguém lista nem lê pelo app (quem confere o código é o servidor).
    match /vinculosWhatsapp/{codigo} {
      allow create: if logado() && !bloqueado(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'criadoEm', 'expira']);
      allow delete: if logado() && resource.data.uid == request.auth.uid;
      allow read, update: if false;
    }
    // whatsappNumeros/{telefone}: qual conta usa cada número. Só o servidor cria;
    // a própria pessoa pode ver e desligar o número dela.
    match /whatsappNumeros/{tel} {
      allow get, delete: if logado() && resource.data.uid == request.auth.uid;
      allow list, create, update: if false;
    }

    // Cadastro e acessos
    match /acessos/{uid} {
      allow read: if dono(uid) || ehAdmin();
      // Criar o próprio cadastro: com o e-mail da própria conta e sem se bloquear
      allow create: if dono(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('bloqueado', false) == false
        && (!('idade' in request.resource.data) || (request.resource.data.idade is int && request.resource.data.idade >= 13 && request.resource.data.idade <= 120));
      // A pessoa atualiza os próprios acessos, mas não muda o bloqueio nem a data de criação.
      // O administrador só mexe no bloqueio.
      allow update: if (dono(uid)
          && request.resource.data.get('bloqueado', false) == resource.data.get('bloqueado', false)
          && request.resource.data.criadoEm == resource.data.criadoEm)
        || (ehAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bloqueado', 'bloqueadoEm', 'bloqueadoPor']));
      // A própria pessoa pode apagar o cadastro ao excluir a conta
      allow delete: if dono(uid);
    }

    // Administradores: cada um só confere a si mesmo; ninguém cria pelo app
    match /admins/{uid} {
      allow read: if dono(uid);
      allow write: if false;
    }

    // ===== GESTÕES COMPARTILHADAS =====
    // perfis/{id}: lista das gestões compartilhadas de cada conta (só a própria pessoa)
    match /perfis/{uid} {
      allow read, write: if dono(uid);
    }

    // espacos/{id}: nome, dono, membros { uid: 'dono' | 'convidado' }, nomes, código atual
    function espaco(eid) { return get(/databases/$(database)/documents/espacos/$(eid)).data; }
    function membroDe(eid) { return logado() && request.auth.uid in espaco(eid).membros; }
    function donoDe(eid) { return logado() && espaco(eid).membros[request.auth.uid] == 'dono'; }
    function convite(codigo) { return get(/databases/$(database)/documents/convites/$(codigo)).data; }

    match /espacos/{eid} {
      allow read: if logado() && request.auth.uid in resource.data.membros && !bloqueado(request.auth.uid);
      // Criar: a pessoa é a única dona
      allow create: if logado() && !bloqueado(request.auth.uid)
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.membros.keys().hasOnly([request.auth.uid])
        && request.resource.data.membros[request.auth.uid] == 'dono';
      allow update: if logado() && !bloqueado(request.auth.uid) && (
        // O dono muda nome, código e membros, mas não deixa de ser dono
        (resource.data.membros[request.auth.uid] == 'dono'
          && request.resource.data.dono == resource.data.dono
          && request.resource.data.membros[request.auth.uid] == 'dono')
        // Entrar com um código válido desta gestão, como convidado
        || (!(request.auth.uid in resource.data.membros)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'nomes', 'codigoUsado'])
          && request.resource.data.membros.diff(resource.data.membros).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.membros[request.auth.uid] == 'convidado'
          && request.resource.data.nomes.diff(resource.data.nomes).affectedKeys().hasOnly([request.auth.uid])
          && convite(request.resource.data.codigoUsado).espaco == eid
          && convite(request.resource.data.codigoUsado).ativo == true)
        // Convidado sai da gestão
        || (resource.data.membros[request.auth.uid] == 'convidado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'nomes'])
          && request.resource.data.membros.diff(resource.data.membros).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.membros))
      );
      allow delete: if logado() && resource.data.dono == request.auth.uid;

      // Todos os membros veem tudo. O convidado lança, mas só o dono apaga
      // e só o dono muda metas e planejamento.
      match /transacoes/{item} {
        allow read, create: if membroDe(eid) && !bloqueado(request.auth.uid);
        // Editar: o dono edita tudo; o convidado só o que ele mesmo lançou
        allow update: if donoDe(eid) || (membroDe(eid) && !bloqueado(request.auth.uid)
          && resource.data.get('autorUid', '') == request.auth.uid
          && request.resource.data.get('autorUid', '') == request.auth.uid);
        allow delete: if donoDe(eid);
      }
      match /recorrentes/{item} {
        allow read, create, update: if membroDe(eid) && !bloqueado(request.auth.uid);
        allow delete: if donoDe(eid);
      }
      match /historico/{item} {
        allow read, create: if membroDe(eid) && !bloqueado(request.auth.uid);
        allow update, delete: if donoDe(eid);
      }
      match /metas/{item} {
        allow read: if membroDe(eid) && !bloqueado(request.auth.uid);
        allow create, update, delete: if donoDe(eid);
      }
      match /config/{item} {
        allow read: if membroDe(eid) && !bloqueado(request.auth.uid);
        allow write: if donoDe(eid);
      }
    }

    // convites/{codigo}: quem sabe o código consegue ler a qual gestão ele leva
    match /convites/{codigo} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado() && espaco(request.resource.data.espaco).dono == request.auth.uid
        && request.resource.data.criadoPor == request.auth.uid;
      allow update, delete: if logado() && resource.data.criadoPor == request.auth.uid;
    }

    // Qualquer outra coleção fica fechada
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
